#!/usr/bin/env bash
#
# omareel — Loom-style screen recording for Omarchy.
#
#   record area / window / screen with gpu-screen-recorder (GPU encode),
#   optional webcam bubble, chosen microphone + system-audio source
#   -> post-process: trim, RNNoise denoise, loudness normalise, faststart
#   -> optional upload (rclone: R2 / S3 / B2 / S3-compatible / any remote)
#   -> share link (or file path) copied to the clipboard
#
# The shell plugin only reads $STATE_FILE; every phase change is written there
# so the floating controls and the bar launcher stay in sync.
#
# Usage:
#   omareel start [area|window|screen] [--no-mic] [--desktop-audio] [--webcam]
#                 [--no-denoise] [--no-upload] [--region=WxH+X+Y]
#   omareel stop | cancel | dismiss | toggle | status | last | open | menu
#   omareel upload last|<video.mp4> [--title="…"]   # share one recording
#   omareel rename last|<video.mp4> "<title>"        # rename the local files (+ thumbnail, raw)
#   omareel page last|<video.mp4>                    # re-upload only the share page (new design)
#   omareel copy   last|<video.mp4>                  # copy its link, or path if local
#   omareel devices                      # JSON: mics, outputs, cameras
#   omareel doctor                       # JSON: deps, denoiser in use, upload state
#   omareel config get | merge '<json>'  # read / deep-merge omareel.json
#   omareel remote save|status|test      # upload credentials -> rclone.conf
#   omareel finalize <raw.mp4> [out.mp4]
#   omareel setup [--link]               # deps, denoise models, ~/.local/bin link

set -uo pipefail

SELF="$(readlink -f "${BASH_SOURCE[0]}")"
PLUGIN_DIR="$(dirname "$(dirname "$SELF")")"
CONFIG_FILE="${OMAREEL_CONFIG:-$HOME/.config/omarchy/omareel.json}"
RUNTIME_DIR="${XDG_RUNTIME_DIR:-/tmp}/omareel"
STATE_FILE="$RUNTIME_DIR/state.json"
LOG_FILE="$RUNTIME_DIR/omareel.log"
PID_FILE="$RUNTIME_DIR/gsr.pid"
CAM_PID_FILE="$RUNTIME_DIR/cam.pid"
MODEL_DIR="$HOME/.local/share/omareel/models"
RCLONE_CONF="${RCLONE_CONFIG:-$HOME/.config/rclone/rclone.conf}"
RCLONE_REMOTE="omareel"
INDEX_FILE_NAME="index.jsonl"
LADSPA_RNNOISE=/usr/lib/ladspa/librnnoise_ladspa.so

mkdir -p "$RUNTIME_DIR"

# ---------------------------------------------------------------- config ---

default_config() {
  cat <<'JSON'
{
  "outputDir": "~/Videos/Omareel",
  "fps": 30,
  "codec": "h264",
  "quality": "very_high",
  "windowCaptureMode": "region",
  "mic": true,
  "micDevice": "default",
  "micVolumePercent": 80,
  "manageMicVolume": false,
  "desktopAudio": false,
  "desktopDevice": "default",
  "webcam": false,
  "webcamDevice": "auto",
  "webcamSize": "medium",
  "webcamShape": "frame",
  "webcamPosition": "bottom-right",
  "webcamZoom": "full",
  "denoise": true,
  "denoiseEngine": "auto",
  "denoiseModel": "bd",
  "denoiseStrength": "normal",
  "micGainDb": 0,
  "vadThreshold": 50,
  "vadGraceMs": 300,
  "vadRetroactiveMs": 50,
  "desktopMix": 0.5,
  "keepRaw": true,
  "upload": {
    "auto": false,
    "provider": "none",
    "accountId": "",
    "region": "",
    "endpoint": "",
    "bucket": "",
    "prefix": "",
    "remote": "",
    "publicBase": "",
    "playerPage": true
  }
}
JSON
}

ensure_config() (
  mkdir -p "$(dirname "$CONFIG_FILE")"
  exec {config_lock}>"$CONFIG_FILE.lock"
  flock "$config_lock" || return 1
  if [[ ! -f $CONFIG_FILE ]]; then
    mkdir -p "$(dirname "$CONFIG_FILE")"
    default_config >"$CONFIG_FILE"
  fi

  # <= 0.7.7 called the camera placement key webcamCorner. During a hot
  # plugin reload the old launcher can briefly keep running and write that
  # key even after the recorder has learned webcamPosition. Canonicalise it
  # on every invocation so two conflicting placement values can never exist.
  if jq -e 'has("webcamCorner")' "$CONFIG_FILE" >/dev/null 2>&1; then
    local tmp="$CONFIG_FILE.tmp"
    jq --indent 2 '.webcamPosition = .webcamCorner | del(.webcamCorner)' \
      "$CONFIG_FILE" >"$tmp" && mv "$tmp" "$CONFIG_FILE"
  fi
)

# cfg <jq-path> <default>
# cfg <jq-path> <default>. Not `//`: jq's alternative operator treats false
# like null, which made every toggle switched off read as its default.
cfg() {
  local value
  value=$(jq -r "$1" "$CONFIG_FILE" 2>/dev/null)
  [[ -n $value && $value != "null" ]] && printf '%s' "$value" || printf '%s' "$2"
}

# config_merge '<json>' — deep-merge a patch into the config file.
config_merge() (
  exec {config_lock}>"$CONFIG_FILE.lock"
  flock "$config_lock" || return 1
  local patch="$1" tmp
  jq -e . <<<"$patch" >/dev/null 2>&1 || {
    echo "config merge: invalid JSON" >&2
    return 2
  }
  tmp="$CONFIG_FILE.tmp"
  # Accept placement writes from both the current launcher and an old QML
  # instance that is still alive while Omarchy reloads the plugin. Always
  # persist only webcamPosition so the backend and UI cannot disagree.
  jq --indent 2 --argjson p "$patch" '
    ($p | if has("webcamCorner")
          then .webcamPosition = .webcamCorner | del(.webcamCorner)
          else . end) as $normalized
    | (. * $normalized) | del(.webcamCorner)
  ' "$CONFIG_FILE" >"$tmp" && mv "$tmp" "$CONFIG_FILE"
)

expand_home() { printf '%s' "${1/#\~/$HOME}"; }

# ----------------------------------------------------------------- state ---

# set_state phase [key=value ...]   (integers pass through as numbers)
set_state() {
  local phase="$1"
  shift
  local args=(--arg phase "$phase" --argjson now "$(date +%s)")
  local filter='{phase: $phase, updatedAt: $now}'
  local kv key value
  for kv in "$@"; do
    key="${kv%%=*}"
    value="${kv#*=}"
    if [[ $value =~ ^-?[0-9]+$ || $value == true || $value == false ]]; then
      args+=(--argjson "$key" "$value")
    else
      args+=(--arg "$key" "$value")
    fi
    filter+=" + {$key: \$$key}"
  done
  local previous='{}'
  [[ -f $STATE_FILE ]] && previous=$(cat "$STATE_FILE")
  # Carry the recording identity across phases so the UI can keep showing the
  # target/timer while processing and the URL when done.
  jq -n "${args[@]}" --argjson prev "$previous" \
    '($prev | {id, target, targetKind, region, file, startedAt, stoppedAt, url, title,
      webcamSize, webcamShape, webcamPosition, webcamZoom}) + '"$filter" \
    >"$STATE_FILE.tmp" && mv "$STATE_FILE.tmp" "$STATE_FILE"
  omarchy-shell -q omarchy.indicators refresh 2>/dev/null || true
}

# state_get <key>: empty when unset (jq's // would also swallow a false).
state_get() { jq -r "if .$1 == null then empty else .$1 end" "$STATE_FILE" 2>/dev/null; }
current_phase() { [[ -f $STATE_FILE ]] && state_get phase || echo idle; }

reset_state() {
  jq -n '{phase: "idle", updatedAt: (now | floor)}' >"$STATE_FILE.tmp" && mv "$STATE_FILE.tmp" "$STATE_FILE"
  rm -f "$PID_FILE"
  omarchy-shell -q omarchy.indicators refresh 2>/dev/null || true
}

notify() { omarchy-notification-send "$@" 2>/dev/null || notify-send "$@" 2>/dev/null || true; }
log() { echo "$(date '+%F %T') $*" >>"$LOG_FILE"; }

gsr_running() {
  local pid
  pid=$(cat "$PID_FILE" 2>/dev/null) || return 1
  [[ $pid =~ ^[1-9][0-9]*$ ]] || return 1
  [[ $(readlink "/proc/$pid/exe" 2>/dev/null) == */gpu-screen-recorder ]] || return 1
  kill -0 "$pid" 2>/dev/null
}

# --------------------------------------------------------------- devices ---

# JSON lists for the launcher's dropdowns.
cmd_devices() {
  local audio
  audio=$(gpu-screen-recorder --list-audio-devices 2>/dev/null)
  local cams
  cams=$(omarchy-capture-webcam-list 2>/dev/null)
  jq -n --arg audio "$audio" --arg cams "$cams" '
    def rows: split("\n") | map(select(length > 0));
    ($audio | rows | map(split("|") | {value: .[0], label: (.[1] // .[0])})) as $a |
    {
      mics: ([{value: "default", label: "System default microphone"}]
             + ($a | map(select(.value != "default_input" and .value != "default_output"
                                and (.value | endswith(".monitor") | not))))),
      outputs: ([{value: "default", label: "System default output"}]
             + ($a | map(select(.value | endswith(".monitor")))
                  | map(.label |= sub("^Monitor of "; "")))),
      cameras: ([{value: "auto", label: "First available camera"}]
             + ($cams | rows | map(capture("^(?<value>/dev/video[0-9]+)\\s+(?<label>.*)$")
                                 | .loopback = (.label | test("loopback"; "i"))
                                 | .label |= (sub("\\s*\\(.*$"; "") | sub(":\\s*$"; "")))))
    }' | camera_busy_annotate
}

# Add "busy": "<holder>" to each camera entry that another process has open.
camera_busy_annotate() {
  local json holder dev
  json=$(cat)
  for dev in $(jq -r '.cameras[].value | select(startswith("/dev/"))' <<<"$json"); do
    if holder=$(camera_holder "$dev"); then
      json=$(jq --arg d "$dev" --arg h "$holder" '(.cameras[] | select(.value == $d)).busy = $h' <<<"$json")
    fi
  done
  echo "$json"
}

audio_sources() {
  local mic="$1" mic_dev="$2" desktop="$3" desktop_dev="$4" known
  known=$(gpu-screen-recorder --list-audio-devices 2>/dev/null | cut -d'|' -f1)
  # A chosen device that is gone (unplugged headset, docked-off camera mic)
  # must not stop the take: fall back to the default.
  audio_known() { [[ -z $known ]] || grep -qxF -- "$1" <<<"$known"; }
  # Keep the microphone first and desktop audio second. Repeating `-a` gives
  # gpu-screen-recorder separate tracks, so voice cleanup never denoises music
  # or application audio.
  if [[ $mic == true ]]; then
    [[ $mic_dev == default || -z $mic_dev ]] && mic_dev="default_input"
    audio_known "$mic_dev" || { log "audio: $mic_dev not present, using default_input"; mic_dev="default_input"; }
    printf 'mic\t%s\n' "$mic_dev"
  fi
  if [[ $desktop == true ]]; then
    [[ $desktop_dev == default || -z $desktop_dev ]] && desktop_dev="default_output"
    audio_known "$desktop_dev" || { log "audio: $desktop_dev not present, using default_output"; desktop_dev="default_output"; }
    printf 'desktop\t%s\n' "$desktop_dev"
  fi
}

# Browser calls can leave a USB microphone at a much lower PipeWire/Pulse
# source volume than the user selected (the Blue was observed at 45%). Reapply
# a predictable capture level immediately before each take. This is preferable
# to a large post-gain: the recorded waveform stays healthy and every cleanup
# threshold sees a consistent input. Failure is non-fatal on non-Pulse setups.
prepare_mic_source() {
  local source="$1" percent pulse_source
  # System gain belongs to the user, not the recorder. Legacy configs also
  # default to preserving it; opt in explicitly to per-take volume control.
  [[ $(cfg .manageMicVolume false) == true ]] || return 0
  percent=$(cfg .micVolumePercent 80)
  [[ $percent =~ ^[0-9]+$ ]] || percent=80
  ((percent < 25)) && percent=25
  ((percent > 100)) && percent=100
  pulse_source="$source"
  [[ $pulse_source == default_input || $pulse_source == default ]] && pulse_source=@DEFAULT_SOURCE@
  if pactl set-source-volume "$pulse_source" "${percent}%" >/dev/null 2>&1; then
    log "audio: capture volume ${percent}% ($source)"
  else
    log "audio: could not set capture volume for $source; continuing unchanged"
  fi
}

# ---------------------------------------------------------------- webcam ---

# webcam_device <device|auto> -> resolved device path (auto skips loopbacks)
# Same mpv overlay Omarchy's recorder uses, so the WebcamOverlay window rules
# and omarchy-capture-webcam-resize apply unchanged.
# camera_holder <device> -> "Chromium (pid 1234)" when another process has the
# camera open, else empty. A UVC camera streams to one process at a time, so a
# browser call (Slack, Meet, Teams) makes every other open fail with a
# misleading "Failed to recognize file format".
camera_holder() {
  local device="$1" pid comm
  for pid in $(fuser "$device" 2>/dev/null); do
    [[ $pid == $$ ]] && continue
    comm=$(ps -o comm= -p "$pid" 2>/dev/null || true)
    [[ -n $comm ]] || continue
    case "$comm" in
    chrom*) comm="Chromium" ;;
    firefox*) comm="Firefox" ;;
    esac
    echo "$comm"
    return 0
  done
  return 1
}

# kill_tracked <pidfile> <program> — kill the recorded pid only while it still
# runs that program; a reused pid must never take an unrelated process down.
kill_tracked() {
  local pidfile="$1" program="$2" pid
  [[ -f $pidfile ]] || return 0
  pid=$(cat "$pidfile")
  if [[ -n $pid ]] && [[ $(ps -o comm= -p "$pid" 2>/dev/null) == "$program" ]]; then
    kill -INT "$pid" 2>/dev/null || true
    local count=0
    while kill -0 "$pid" 2>/dev/null && ((count < 50)); do
      sleep 0.1
      ((count++))
    done
    kill -9 "$pid" 2>/dev/null || true
  fi
  rm -f "$pidfile"
}

# webcam_device [configured] -> /dev/videoN. "auto" skips v4l2loopback devices,
# which list first but only carry frames while something feeds them.
webcam_device() {
  local device="${1:-auto}"
  if [[ $device == auto || -z $device ]]; then
    device=$(omarchy-capture-webcam-list 2>/dev/null | grep -vi loopback | sed -n '1s/[[:space:]].*//p')
    [[ -n $device ]] || device=$(omarchy-capture-webcam-list 2>/dev/null | sed -n '1s/[[:space:]].*//p')
  fi
  [[ -n $device && -e $device ]] || return 1
  echo "$device"
}

# The camera, in every mode, works like a screen studio: one ffmpeg records
# it to <id>.cam.mp4 (wall-clock timestamps, kept with -copyts so finalize can
# line it up with the recording) and tees the same frames to an mpv self-view
# in the corner where the camera will be. The self-view is a floating window
# that Hyprland hides from window/portal capture, so:
#   Area/Screen: the self-view sits inside the capture and *is* the camera
#                in the video, exactly as you see it.
#   Window:      the capture cannot see it; finalize draws the same frame in.
# webcam_failed <device> <what> — log it and tell the user why, naming the
# program that holds the camera when there is one.
webcam_failed() {
  local device="$1" what="$2" holder
  if holder=$(camera_holder "$device"); then
    log "webcam $device: $what; held by $holder"
    notify -u critical -t 8000 "Omareel: camera skipped" "The camera is in use by $holder (a call or a tab). End it, then record again."
  else
    log "webcam $device: $what (see output above)"
    notify -u critical -t 8000 "Omareel: camera did not start" "See $LOG_FILE"
  fi
}

# Hyprland's stock rules float/pin classes WebcamOverlay-small|medium|large only.
overlay_class() { case "$1" in small | medium | large) echo "WebcamOverlay-$1" ;; *) echo "WebcamOverlay-large" ;; esac; }

# start_webcam <device> <out.cam.mp4> [region] [size] [shape] [position] [zoom]
start_webcam() {
  local device="$1" out="$2" region="${3:-}" formats mode size fps input=()
  local bubble_size="${4:-$(cfg .webcamSize medium)}"
  local shape="${5:-$(cfg .webcamShape frame)}"
  local position="${6:-$(webcam_position)}"
  local zoom="${7:-$(cfg .webcamZoom full)}"
  cleanup_webcam # an orphaned capture from a crashed run would hold the camera
  formats=$(timeout 5 v4l2-ctl --list-formats-ext -d "$device" 2>/dev/null) || return 1
  mode=$(python3 "$PLUGIN_DIR/bin/system-check.py" camera <<<"$formats") || return 1
  size=$(jq -r '"\(.width)x\(.height)"' <<<"$mode")
  fps=$(jq -r '.fps' <<<"$mode")
  input=(-input_format "$(jq -r '.format' <<<"$mode")")
  log "camera negotiated $device: $size at $fps fps ($(jq -r .format <<<"$mode"))"

  # Self-view shape: crop to the shape's aspect, then a pre-rendered alpha
  # mask (alphamerge is a plane copy; a per-frame geq mask ran at 14 fps).
  local cam_w="${size%x*}" cam_h="${size#*x}" crop_w crop_h mask="$RUNTIME_DIR/selfview-mask.png"
  read -r crop_w crop_h <<<"$(camera_crop_size "$cam_w" "$cam_h" "$shape" "$zoom")"
  bubble_mask_png "$crop_w" "$crop_h" "$shape" "$mask" || return 1

  ffmpeg -y -v warning -f v4l2 "${input[@]}" -framerate "$fps" -video_size "$size" \
    -use_wallclock_as_timestamps 1 -i "$device" \
    -map 0:v -c:v libx264 -preset ultrafast -tune zerolatency -crf 20 -pix_fmt yuv420p -g 30 -copyts \
    -f tee "[f=mp4:onfail=ignore]$out|[f=nut:onfail=ignore]pipe:1" \
    2>>"$LOG_FILE" > >(mpv - --profile=low-latency --untimed --no-cache --demuxer-lavf-format=nut --background=none \
      "--vf=lavfi=[$(bubble_crop "$shape" "$zoom")scale=$crop_w:$crop_h,format=rgba[a];movie=$mask,format=gray[m];[a][m]alphamerge]" \
      --title="WebcamOverlay" --wayland-app-id="$(overlay_class "$bubble_size")" \
      --no-border --no-audio --no-osc --osd-level=0 --msg-level=all=warn >>"$LOG_FILE" 2>&1) &
  echo $! >"$CAM_PID_FILE" # right away: nothing backgrounded later may replace it

  ( # put the self-view in its corner once the window exists; say so if it never does
    local n placed=false
    for n in $(seq 60); do
      sleep 0.1
      if place_overlay "$(overlay_class "$bubble_size")" "$bubble_size" "$shape" "$position" "$region"; then
        placed=true
        break
      fi
    done
    if [[ $placed == true ]]; then
      log "webcam self-view shown ($(hyprctl -j clients | jq -c 'first(.[] | select(.title == "WebcamOverlay")) | {at, size, ws: .workspace.id}' 2>/dev/null))"
    elif webcam_capture_alive; then
      log "webcam self-view window did not appear within 6 s (mpv output above)"
      notify -u normal -t 6000 "Omareel: camera self-view did not appear" "The camera is still being recorded. See $LOG_FILE"
    fi
  ) &
  disown
}

# Camera warm-up is ~1 s; wait (bounded) until frames are flowing so the
# camera is there from the first frame of the recording.
# wait_webcam_capture <device> <out.cam.mp4>
wait_webcam_capture() {
  local device="$1" out="$2" waited=0
  while ((waited < 25)) && [[ $(stat -c %s "$out" 2>/dev/null || echo 0) -lt 4096 ]]; do
    if ! webcam_capture_alive; then
      webcam_failed "$device" "capture exited early"
      rm -f "$CAM_PID_FILE" "$out"
      return 1
    fi
    sleep 0.1
    ((waited++))
  done
}

stop_webcam_capture() { kill_tracked "$CAM_PID_FILE" ffmpeg; }

webcam_capture_alive() {
  local pid
  pid=$(cat "$CAM_PID_FILE" 2>/dev/null) || return 1
  [[ -n $pid ]] && kill -0 "$pid" 2>/dev/null
}

cleanup_webcam() {
  # Self-view first: it is ffmpeg's tee slave, and an ffmpeg blocked on a
  # full pipe cannot write the mp4 trailer when told to stop.
  # Anchored to mpv's own command line: a bare -f "WebcamOverlay" also kills
  # any shell or editor whose arguments merely mention the word.
  pkill -f -- '^mpv .*--title=WebcamOverlay' 2>/dev/null
  stop_webcam_capture
  # A camera capture whose pid file was lost (crash, old version) would hold
  # the camera for every later take; only Omareel writes *.cam.mp4 with tee.
  pkill -INT -f -- '^ffmpeg .*\.cam\.mp4' 2>/dev/null
  rm -f "$RUNTIME_DIR/selfview-mask.png"
}

# ------------------------------------------------------------- recording ---

# Mirrors Omarchy's recorder: monitors above 4K are downscaled to 4K.
monitor_scale_arg() {
  local name="$1" width height
  read -r width height < <(hyprctl monitors -j | jq -r --arg n "$name" '.[] | select(.name == $n) | "\(.width) \(.height)"')
  if ((width > 3840 || height > 2160)); then
    echo "-s 3840x2160"
  fi
}

pick_area() {
  # "monitor:NAME" or "X,Y WxH"; non-zero when the picker is cancelled.
  local picked
  picked=$(omarchy-capture-region smart --match-monitor) || return 1
  if [[ $picked == monitor:* ]]; then
    echo "$picked"
  elif [[ $picked =~ ^(-?[0-9]+),(-?[0-9]+)[[:space:]]([0-9]+)x([0-9]+)$ ]]; then
    # gpu-screen-recorder's geometry grammar is WxH+X+Y. Keep the separator
    # before a signed coordinate: x=-132 must become "+-132", not "-132".
    printf 'region:%sx%s+%d+%d\n' "${BASH_REMATCH[3]}" "${BASH_REMATCH[4]}" \
      "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}"
  else
    return 1
  fi
}

# Intersect a picked rectangle with the usable area of the monitor where most
# of it is visible. The usable area excludes Hyprland's reserved top/bottom
# bar, which keeps the movable Omareel bar control out of Window recordings.
# Hyprland's scrolling layout can leave a tiled window partly outside the
# monitor (for example x=-116). Capturing that off-monitor area through KMS
# records unrelated pixels rather than hidden window content, so Window mode
# must only record the selected window's visible portion.
visible_monitor_region() {
  local x="$1" y="$2" width="$3" height="$4"
  local monitors rows mx my mw mh ix iy right bottom iw ih area
  local best_area=0 best_x=0 best_y=0 best_w=0 best_h=0

  monitors=$(hyprctl monitors -j 2>/dev/null) || return 1
  rows=$(jq -r '
    .[]
    | (.width / .scale | floor) as $normalWidth
    | (.height / .scale | floor) as $normalHeight
    | .transform as $transform
    | (if ([1, 3, 5, 7] | index($transform)) != null
       then [$normalHeight, $normalWidth]
       else [$normalWidth, $normalHeight]
       end) as $size
    | (.reserved[0] // 0) as $left
    | (.reserved[1] // 0) as $top
    | (.reserved[2] // 0) as $right
    | (.reserved[3] // 0) as $bottom
    | [.x + $left, .y + $top,
       $size[0] - $left - $right, $size[1] - $top - $bottom]
    | @tsv
  ' <<<"$monitors") || return 1

  while IFS=$'\t' read -r mx my mw mh; do
    [[ $mx =~ ^-?[0-9]+$ && $my =~ ^-?[0-9]+$ \
      && $mw =~ ^[0-9]+$ && $mh =~ ^[0-9]+$ ]] || continue
    ((x > mx)) && ix=$x || ix=$mx
    ((y > my)) && iy=$y || iy=$my
    ((x + width < mx + mw)) && right=$((x + width)) || right=$((mx + mw))
    ((y + height < my + mh)) && bottom=$((y + height)) || bottom=$((my + mh))
    iw=$((right - ix))
    ih=$((bottom - iy))
    ((iw > 0 && ih > 0)) || continue
    area=$((iw * ih))
    if ((area > best_area)); then
      best_area=$area
      best_x=$ix
      best_y=$iy
      best_w=$iw
      best_h=$ih
    fi
  done <<<"$rows"

  ((best_area > 0)) || return 1
  printf '%sx%s+%d+%d\n' "$best_w" "$best_h" "$best_x" "$best_y"
}

# Reliable Window mode: select an exact Hyprland window rectangle and capture
# its on-screen pixels through KMS. The portal can lose its GPU buffers when a
# window changes size by even one pixel; gpu-screen-recorder then repeats the
# last frame while audio continues. Direct region capture has fixed dimensions
# for the whole take and cannot enter that failure mode.
pick_window() {
  local picked x y width height original visible
  picked=$(omarchy-capture-region windows) || return 1
  if [[ $picked =~ ^(-?[0-9]+),(-?[0-9]+)[[:space:]]([0-9]+)x([0-9]+)$ ]]; then
    x=${BASH_REMATCH[1]}
    y=${BASH_REMATCH[2]}
    width=${BASH_REMATCH[3]}
    height=${BASH_REMATCH[4]}
    printf -v original '%sx%s+%d+%d' "$width" "$height" "$x" "$y"
    visible=$(visible_monitor_region "$x" "$y" "$width" "$height") || return 1
    [[ $visible == "$original" ]] || log "window: clipped off-monitor region $original -> $visible"
    printf 'window-region:%s\n' "$visible"
  else
    return 1
  fi
}

# Capture the monitor's usable rectangle, including rotation and logical
# scaling, so the reserved system bar (and REC/STOP control) stays out of a
# Screen take as it already does for Window takes.
monitor_capture_region() {
  local name="$1" rect x y width height
  rect=$(hyprctl monitors -j | jq -er --arg n "$name" '
    .[] | select(.name == $n)
    | (.width / .scale | floor) as $w | (.height / .scale | floor) as $h
    | .transform as $transform
    | (if ([1,3,5,7] | index($transform)) != null then [$h,$w] else [$w,$h] end) as $size
    | [.x,.y,$size[0],$size[1]] | @tsv
  ') || return 1
  read -r x y width height <<<"$rect"
  visible_monitor_region "$x" "$y" "$width" "$height"
}

new_id() {
  # Random UUID: the local file name until it is given a title, and the object
  # key on the upload destination for good, so links stay unguessable and
  # survive renames.
  uuidgen 2>/dev/null || cat /proc/sys/kernel/random/uuid
}

# Title → safe file name. "Sprint demo: API v2" → "Sprint-demo-API-v2"
slugify() {
  local s
  s=$(printf '%s' "$1" | sed -E 's/[^[:alnum:] _-]+//g; s/[[:space:]]+/-/g; s/-{2,}/-/g; s/^-+//; s/-+$//')
  printf '%.80s' "$s"
}

recording_dir() { expand_home "$(cfg .outputDir "~/Videos/Omareel")"; }

# resolve_recording last|<file> -> absolute path of the mp4 (or fails)
resolve_recording() {
  local target="${1:-last}" file=""
  if [[ $target == last ]]; then
    file=$(state_get file)
    [[ -n $file && -f $file ]] || file=$(tail -1 "$(recording_dir)/$INDEX_FILE_NAME" 2>/dev/null | jq -r '.file // empty')
  else
    file="$target"
    [[ $file == /* ]] || file="$PWD/$file"
  fi
  [[ -n $file && -f $file ]] || { echo "no such recording: ${file:-$target}" >&2; return 1; }
  echo "$file"
}

# rename_recording <file> <title> -> prints the new path. Moves the mp4, its
# thumbnail and raw take together, updates index.jsonl and the live state.
rename_recording() {
  local file="$1" title="$2" dir slug new n=2
  dir=$(dirname "$file")
  slug=$(slugify "$title")
  [[ -n $slug ]] || slug=$(basename "${file%.mp4}")
  new="$dir/$slug.mp4"
  if [[ $new != "$file" ]]; then
    while [[ -e $new || -e ${new%.mp4}.raw.mp4 ]]; do
      new="$dir/$slug-$n.mp4"
      n=$((n + 1))
    done
    mv "$file" "$new"
    [[ -f ${file%.mp4}.jpg ]] && mv "${file%.mp4}.jpg" "${new%.mp4}.jpg"
    [[ -f ${file%.mp4}.raw.mp4 ]] && mv "${file%.mp4}.raw.mp4" "${new%.mp4}.raw.mp4"
    log "rename $(basename "$file") -> $(basename "$new")"
  fi
  index_patch "$file" '.file = $new | .title = $title' --arg new "$new" --arg title "$title"
  if [[ -f $STATE_FILE && $(state_get file) == "$file" ]]; then
    jq --arg f "$new" --arg t "$title" '.file = $f | .title = $t' "$STATE_FILE" >"$STATE_FILE.tmp" &&
      mv "$STATE_FILE.tmp" "$STATE_FILE"
    omarchy-shell -q omarchy.indicators refresh 2>/dev/null || true
  fi
  echo "$new"
}

cmd_start() {
  local kind="area" mic desktop webcam denoise upload region_override=""
  mic=$(cfg .mic true)
  desktop=$(cfg .desktopAudio false)
  webcam=$(cfg .webcam false)
  denoise=$(cfg .denoise true)
  upload=none
  [[ $(cfg '.upload.auto' false) == true ]] && upload_ready && upload=rclone

  local arg
  for arg in "$@"; do
    case "$arg" in
    area | window | screen) kind="$arg" ;;
    --no-mic) mic=false ;;
    --mic) mic=true ;;
    --desktop-audio) desktop=true ;;
    --no-desktop-audio) desktop=false ;;
    --webcam) webcam=true ;;
    --no-webcam) webcam=false ;;
    --no-denoise) denoise=false ;;
    --no-upload) upload=none ;;
    --region=*) region_override="${arg#*=}" ;;
    *)
      echo "unknown argument: $arg" >&2
      return 2
      ;;
    esac
  done

  if gsr_running; then
    echo "already recording" >&2
    return 1
  fi
  case "$(current_phase)" in
  picking | starting | processing | uploading)
    notify -u critical -t 3000 "Omareel is still finishing the previous recording"
    return 1
    ;;
  done) reset_state ;;
  esac

  local checks
  if ! checks=$(compatibility_report "$kind" "$@"); then
    start_error "$(jq -r '.errors | join("\n")' <<<"$checks" 2>/dev/null || echo 'Setup check failed. Open Settings → Setup.')"
    return 1
  fi

  local output_dir
  output_dir=$(expand_home "$(cfg .outputDir "~/Videos/Omareel")")
  mkdir -p "$output_dir" || { start_error "Cannot create the recording folder: $output_dir"; return 1; }

  set_state picking targetKind="$kind" error="" warning=""

  local target="" capture_args=() label=""
  if [[ -n $region_override ]]; then
    if [[ $kind == window ]]; then
      target="window-region:$region_override"
    else
      target="region:$region_override"
    fi
  else
    case "$kind" in
    area)
      target=$(pick_area) || {
        reset_state
        return 1
      }
      ;;
    window)
      if [[ $(cfg .windowCaptureMode region) == portal ]]; then
        # Optional true-window capture. It remains useful when the app must be
        # covered, but some portal/GPU combinations cannot survive a resize.
        target="portal"
      else
        target=$(pick_window) || {
          reset_state
          return 1
        }
      fi
      ;;
    screen)
      target="monitor:$(omarchy-hyprland-monitor-focused)"
      ;;
    esac
  fi

  local region=""
  case "$target" in
  monitor:*)
    local mon="${target#monitor:}"
    region=$(monitor_capture_region "$mon") || {
      reset_state
      notify -u critical -t 5000 "Omareel could not find the selected monitor"
      return 1
    }
    capture_args=(-w "$region")
    label="Screen $mon"
    local scale=()
    read -ra scale < <(monitor_scale_arg "$mon")
    capture_args+=("${scale[@]}")
    kind=screen
    ;;
  region:*)
    region="${target#region:}"
    capture_args=(-w "$region")
    label="Area ${region%%+*}"
    kind=area
    ;;
  window-region:*)
    region="${target#window-region:}"
    capture_args=(-w "$region")
    label="Window"
    # Direct KMS capture already includes the camera self-view. Only the
    # optional portal path needs the camera composited after Stop.
    kind=window-direct
    ;;
  portal)
    capture_args=(-w portal -restore-portal-session no)
    label="Window"
    ;;
  esac

  # The camera starts first: it needs ~1 s to warm up, and the extra footage
  # before the recording starts is trimmed by finalize.
  local id raw cam_device webcam_size webcam_shape webcam_position_value webcam_zoom
  id=$(new_id)
  raw="$output_dir/$id.raw.mp4"
  webcam_size=$(cfg .webcamSize medium)
  webcam_shape=$(cfg .webcamShape frame)
  webcam_position_value=$(webcam_position)
  webcam_zoom=$(cfg .webcamZoom full)
  set_state starting file="$raw" targetKind="$kind" target="$label" region="$region"
  if [[ $webcam == true ]]; then
    if cam_device=$(webcam_device "$(cfg .webcamDevice auto)"); then
      if ! start_webcam "$cam_device" "${raw%.raw.mp4}.cam.mp4" "$region" \
        "$webcam_size" "$webcam_shape" "$webcam_position_value" "$webcam_zoom" \
        || ! wait_webcam_capture "$cam_device" "${raw%.raw.mp4}.cam.mp4"; then
        cleanup_webcam
        start_error "Camera could not start. Close apps using it, choose another camera, or turn Camera off."
        return 1
      fi
    else
      start_error "Selected camera is unavailable. Reconnect it, choose another camera, or turn Camera off."
      return 1
    fi
  fi

  local audio_desc="" audio_args=() audio_role audio_source
  while IFS=$'\t' read -r audio_role audio_source; do
    [[ -n $audio_source ]] || continue
    [[ $audio_role != mic ]] || prepare_mic_source "$audio_source"
    audio_args+=(-a "$audio_source")
    [[ -n $audio_desc ]] && audio_desc+=","
    audio_desc+="$audio_role:$audio_source"
  done < <(audio_sources "$mic" "$(cfg .micDevice default)" "$desktop" "$(cfg .desktopDevice default)")
  ((${#audio_args[@]} == 0)) || audio_args+=(-ac aac)

  local fps codec quality
  fps=$(cfg .fps 30)
  codec=$(cfg .codec h264)
  quality=$(cfg .quality very_high)

  log "start kind=$kind target=$target audio=${audio_desc:-none} webcam=$webcam"
  gpu-screen-recorder "${capture_args[@]}" \
    -k "$codec" -q "$quality" -f "$fps" -fm cfr -cursor yes \
    -fallback-cpu-encoding yes "${audio_args[@]}" -o "$raw" >>"$LOG_FILE" 2>&1 &
  local pid=$!
  echo "$pid" >"$PID_FILE"

  # The portal picker can take a while; wait until gsr starts writing.
  local waited=0
  while kill -0 "$pid" 2>/dev/null && [[ ! -s $raw ]] && ((waited < 600)); do
    sleep 0.1
    ((waited++))
  done

  if ! kill -0 "$pid" 2>/dev/null || [[ ! -s $raw ]]; then
    if gsr_running; then
      kill -TERM "$pid" 2>/dev/null || true
      local stop_wait=0
      while gsr_running && ((stop_wait < 30)); do sleep 0.1; ((stop_wait++)); done
      gsr_running && kill -KILL "$pid" 2>/dev/null || true
    fi
    cleanup_webcam
    rm -f "$PID_FILE"
    # Keep partial media for diagnosis/recovery, even on a failed start.
    if [[ $target == portal ]] && tail -20 "$LOG_FILE" | grep -qi -E 'cancel|denied'; then
      reset_state
      return 1 # picker cancelled
    fi
    start_error "No video was produced during startup. Check capture permissions and graphics drivers. Details: $LOG_FILE"
    return 1
  fi

  # Wall-clock moment the recorder started writing: finalize lines the camera
  # take up against it.
  if [[ -f $CAM_PID_FILE ]]; then
    if webcam_capture_alive; then
      date +%s.%N >"${raw%.raw.mp4}.cam.start"
    else
      webcam_failed "${cam_device:-camera}" "capture exited before the recording started"
      stop_webcam_capture
      rm -f "${raw%.raw.mp4}.cam.mp4"
    fi
  fi

  set_state recording id="$id" target="$label" targetKind="$kind" file="$raw" region="$region" \
    startedAt="$(date +%s)" denoise="$denoise" upload="$upload" mic="$mic" desktop="$desktop" \
    webcamSize="$webcam_size" webcamShape="$webcam_shape" \
    webcamPosition="$webcam_position_value" webcamZoom="$webcam_zoom"
}

compatibility_report() { python3 "$PLUGIN_DIR/bin/system-check.py" check "$CONFIG_FILE" "$@"; }

start_error() {
  local message="${1:-Recording could not start. Open Settings → Setup.}"
  log "start failed: $message"
  set_state error error="$message"
  notify -u critical -t 8000 "Omareel could not start recording" "$message"
}

cmd_stop() {
  local phase
  phase=$(current_phase)
  if ! gsr_running; then
    [[ $phase == recording ]] && reset_state
    cleanup_webcam
    echo "not recording" >&2
    return 1
  fi

  local pid raw denoise upload mic desktop webcam_size webcam_shape webcam_position_value webcam_zoom
  pid=$(cat "$PID_FILE")
  raw=$(state_get file)
  denoise=$(state_get denoise)
  upload=$(state_get upload)
  mic=$(state_get mic)
  desktop=$(state_get desktop)
  [[ -n $mic ]] || mic=$(cfg .mic true)
  [[ -n $desktop ]] || desktop=$(cfg .desktopAudio false)
  webcam_size=$(state_get webcamSize)
  webcam_shape=$(state_get webcamShape)
  webcam_position_value=$(state_get webcamPosition)
  webcam_zoom=$(state_get webcamZoom)
  [[ -n $webcam_size ]] || webcam_size=$(cfg .webcamSize medium)
  [[ -n $webcam_shape ]] || webcam_shape=$(cfg .webcamShape frame)
  [[ -n $webcam_position_value ]] || webcam_position_value=$(webcam_position)
  [[ -n $webcam_zoom ]] || webcam_zoom=$(cfg .webcamZoom full)

  kill -INT "$pid" 2>/dev/null # SIGINT lets gsr write the moov atom
  local count=0
  while kill -0 "$pid" 2>/dev/null && ((count < 80)); do
    sleep 0.1
    ((count++))
  done
  if kill -0 "$pid" 2>/dev/null; then
    kill -9 "$pid" 2>/dev/null
    notify -u critical -t 5000 "Omareel recording error" "Recorder had to be force-killed; the video may be corrupted."
  fi
  rm -f "$PID_FILE"
  cleanup_webcam

  if [[ ! -s $raw ]]; then
    reset_state
    notify -u critical -t 5000 "Omareel recording is empty"
    return 1
  fi

  set_state processing progress=0 stoppedAt="$(date +%s)"
  local final="${raw%.raw.mp4}.mp4" processing_warning=""
  local composite=false
  [[ $(state_get targetKind) == window ]] && composite=true
  if ! finalize_video "$raw" "$final" "$denoise" "$composite" "$mic" "$desktop" \
    "$webcam_size" "$webcam_shape" "$webcam_position_value" "$webcam_zoom"; then
    # Keep the raw source and tell the user this is an unprocessed fallback.
    cp -- "$raw" "$final" || {
      set_state error error="Could not save the final video. Original retained at $raw" file="$raw"
      notify -u critical -t 8000 "Omareel could not finish saving" "Original retained at $raw"
      return 1
    }
    processing_warning="Cleanup failed; saved the unprocessed recording. The raw take is retained."
  elif [[ $(cfg .keepRaw true) != true ]]; then
    rm -f "$raw" "${raw%.raw.mp4}.cam.mp4"
  fi
  rm -f "${raw%.raw.mp4}.cam.start"

  local thumb="${final%.mp4}.jpg"
  make_thumbnail "$final" "$thumb"

  local url="" share
  if [[ ${upload:-none} != none ]]; then
    set_state uploading file="$final" progress=0
    url=$(upload_video "$final" "$thumb") || url=""
  fi

  share="${url:-$final}"
  printf '%s' "$share" | wl-copy 2>/dev/null || true
  append_index "$final" "$url"

  local can_upload=false
  [[ -z $url ]] && upload_ready && can_upload=true
  set_state done file="$final" url="$url" progress=100 canUpload="$can_upload" warning="$processing_warning"
  if [[ -n $url ]]; then
    notify -u normal -t 10000 --image "$thumb" "Omareel link copied" "$url" --exec xdg-open "$url"
  elif [[ ${upload:-none} != none ]]; then
    notify -u critical -t 10000 --image "$thumb" "Omareel saved, upload failed" "$final" --exec mpv -- "$final"
  elif [[ $can_upload == true ]]; then
    notify -u normal -t 10000 --image "$thumb" "Omareel saved" "Path copied · use Upload on the banner to share" --exec mpv -- "$final"
  else
    notify -u normal -t 10000 --image "$thumb" "Omareel saved" "Path copied · click to play" --exec mpv -- "$final"
  fi
  echo "$share"

  # Keep Open/Copy/Upload available until dismissed or the next recording.
  # A delayed reset from a previous take could otherwise dismiss a newer one.
}

cmd_dismiss() {
  [[ $(current_phase) == done || $(current_phase) == error ]] && reset_state
  true
}

cmd_cancel() {
  if gsr_running; then
    local pid raw
    pid=$(cat "$PID_FILE")
    raw=$(state_get file)
    kill -INT "$pid" 2>/dev/null
    sleep 0.5
    kill -9 "$pid" 2>/dev/null
    stop_webcam_capture
    [[ -n $raw ]] && rm -f "$raw" "${raw%.raw.mp4}.cam.mp4" "${raw%.raw.mp4}.cam.start"
    notify -t 3000 "Omareel recording discarded"
  fi
  cleanup_webcam
  reset_state
}

cmd_toggle() {
  if gsr_running; then
    cmd_stop
  else
    case "$(current_phase)" in
    processing | uploading) ;;
    *) cmd_menu ;;
    esac
  fi
}

cmd_menu() {
  # The bar launcher when the shell has it; else the Omarchy menu tree.
  if [[ $(omarchy-shell omareel status 2>/dev/null) == idle ]]; then
    omarchy-shell omareel toggle
  else
    omarchy-menu toggle trigger.capture.omareel
  fi
}

# ------------------------------------------------------------ processing ---

model_path() {
  local name="$1" checksum
  case "$name" in
  bd) checksum=ae3f7411e1e6a884f839a4a145c394408398f09854dbc1216ee02faafc98a17b ;;
  sh) checksum=70bb6685eb0c2a1d18e2918dca3fbfbd39317010b1802eb1b6ea73a92f3fdec0 ;;
  *) return 1 ;;
  esac
  [[ -f $MODEL_DIR/$name.rnnn ]] || return 1
  [[ $(sha256sum "$MODEL_DIR/$name.rnnn" | cut -d' ' -f1) == "$checksum" ]] || return 1
  echo "$MODEL_DIR/$name.rnnn"
}

# Natural uses light FFT cleanup; Clean and Strong use RNNoise when available.
# Clean restores a small, time-aligned natural component during speech, while
# Strong keeps the fully denoised signal for difficult rooms.
denoise_engine() {
  local wanted strength
  wanted=$(cfg .denoiseEngine auto)
  case "$wanted" in
  ladspa | arnndn | afftdn | off) echo "$wanted"; return ;;
  esac
  strength=$(cfg .denoiseStrength normal)
  if [[ $strength != light ]]; then
    if [[ -f $LADSPA_RNNOISE ]]; then
      echo ladspa
    elif [[ -n $(model_path "$(cfg .denoiseModel bd)") ]]; then
      echo arnndn
    else
      echo afftdn
    fi
  else
    echo afftdn
  fi
}

# Fraction of denoised voice. The LADSPA branch aligns both paths before
# mixing; arnndn provides its own output/input mix.
denoise_mix() {
  case "$(cfg .denoiseStrength normal)" in
  light) echo 0.70 ;;
  strong) echo 1.0 ;;
  *) echo 0.85 ;;
  esac
}

# Measure the installed LADSPA model's delay with the SAME 480-sample block
# size and look-ahead used below. LADSPA does not report a latency port, so
# ffmpeg's latency=1 cannot compensate it. In 1.21 the model itself adds 960
# samples (20 ms), on top of retroactive VAD. Its built-in Dry Mix omits those
# 960 samples and therefore comb-filters speech. Keep that control at zero.
# Probe each graph construction rather than caching a value across upgrades.
ladspa_latency_samples() {
  python3 - "$LADSPA_RNNOISE" "$(cfg .vadRetroactiveMs 50)" <<'PY'
import array, subprocess, sys
try:
    retro = max(0, min(200, int(sys.argv[2])))
    graph = ("asetnsamples=n=480:p=0,ladspa=file=" + sys.argv[1] +
             ":plugin=noise_suppressor_mono:c=c0=0|c1=300|c2=" + str(retro) +
             "|c3=0:latency=0")
    result = subprocess.run([
        "ffmpeg", "-v", "error", "-nostdin", "-f", "lavfi", "-i",
        r"aevalsrc=if(eq(n\,48000)\,0.5\,0):s=48000:d=2",
        "-af", graph, "-f", "f32le", "-"], capture_output=True, check=True, timeout=10)
    samples = array.array("f", result.stdout)
    if sys.byteorder != "little":
        samples.byteswap()
    peak = max(range(len(samples)), key=lambda i: abs(samples[i]))
    delay = peak - 48000
    if not (0 <= delay <= 24000 and abs(samples[peak]) > 1e-7):
        raise ValueError("could not measure RNNoise latency reliably")
    print(delay)
except (ValueError, OSError, subprocess.SubprocessError) as exc:
    print("RNNoise latency probe failed: " + str(exc), file=sys.stderr)
    sys.exit(1)
PY
}

# Keep tone neutral by default: denoising already changes the spectrum.
# Adding bass and cutting presence on every microphone can dull speech.
denoise_tone() {
  echo anull
}

# Light parallel compression evens out speech before loudness normalization,
# without flattening the transients that make a voice sound close and natural.
voice_compressor() {
  case "$(cfg .denoiseStrength normal)" in
  light) echo "anull" ;;
  strong) echo "acompressor=threshold=0.1:ratio=2:attack=12:release=130:knee=3:makeup=1:mix=0.75" ;;
  *) echo "acompressor=threshold=0.125:ratio=1.5:attack=15:release=150:knee=2.8:makeup=1:mix=0.5" ;;
  esac
}

afftdn_filter() {
  case "$(cfg .denoiseStrength normal)" in
  light) echo "afftdn=nr=4:nf=-45:tn=1:gs=3" ;;
  strong) echo "afftdn=nr=11:nf=-36:tn=1:gs=10:ad=0.65" ;;
  *) echo "afftdn=nr=9:nf=-38:tn=1:gs=8:ad=0.6" ;;
  esac
}

# FFT denoising removes steady fan/room noise, but quiet recordings are later
# raised substantially by loudness normalisation. A soft downward expander
# keeps that residual room tone down between phrases without hard-gating word
# endings or filtering the harmonics that give the Blue microphone its warmth.
afftdn_expander() {
  case "$(cfg .denoiseStrength normal)" in
  light) echo "anull" ;;
  strong) echo "agate=threshold=0.022:ratio=2.5:range=0.12:attack=8:release=260:knee=4" ;;
  *) echo "agate=threshold=0.015:ratio=2:range=0.18:attack=8:release=260:knee=4" ;;
  esac
}

# voice_graph <input-label> <engine> <output-label>
# Produces a complete labeled filtergraph fragment for the microphone track.
voice_graph() {
  local input="$1" engine="$2" output="$3" wet dry base tone compressor denoiser delay retro
  wet=$(denoise_mix)
  base="volume=enable='lt(t,0.4)':volume=0,afade=t=in:st=0.4:d=0.05,aformat=sample_fmts=fltp:sample_rates=48000:channel_layouts=mono,volume=$(cfg .micGainDb 0)dB,highpass=f=70"
  tone=$(denoise_tone)
  compressor=$(voice_compressor)
  case "$engine" in
  ladspa)
    delay=$(ladspa_latency_samples) || return 1
    retro=$(cfg .vadRetroactiveMs 50)
    [[ $retro =~ ^[0-9]+$ ]] || retro=50
    ((retro > 200)) && retro=200
    # Explicitly frame into RNNoise's 10 ms blocks. Append its delay at EOF
    # to flush final syllables, then remove that delay before mixing or muxing.
    denoiser="apad=pad_len=$delay,asetnsamples=n=480:p=0,ladspa=file=$LADSPA_RNNOISE:plugin=noise_suppressor_mono:c=c0=$(cfg .vadThreshold 50)|c1=$(cfg .vadGraceMs 300)|c2=$retro|c3=0:latency=0,atrim=start_sample=$delay,asetpts=PTS-STARTPTS"
    if [[ $wet == 1.0 ]]; then
      echo "[$input]$base,$denoiser,$tone,$compressor[$output]"
    else
      dry=$(awk -v w="$wet" 'BEGIN {printf "%.2f", 1-w}')
      # The natural component restores detail during speech. Duck it using
      # the cleaned voice as a guide so it does not restore room hiss in gaps.
      # Pad the dry side too: sidechaingate otherwise sees its EOF while the
      # wet branch is still flushing and can drop the last look-ahead interval.
      echo "[$input]$base,asetnsamples=n=480:p=0,asplit=2[${output}_dry][${output}_in];[${output}_in]$denoiser,asplit=2[${output}_wet][${output}_guide];[${output}_dry]apad=pad_len=$delay[${output}_drypad];[${output}_drypad][${output}_guide]sidechaingate=threshold=0.008:ratio=2:range=0.05:attack=5:release=250:knee=4[${output}_natural];[${output}_wet][${output}_natural]amix=inputs=2:weights='$wet $dry':duration=first:normalize=0,$tone,$compressor[$output]"
    fi
    ;;
  arnndn)
    echo "[$input]$base,arnndn=m=$(model_path "$(cfg .denoiseModel bd)"):mix=$wet,$tone,$compressor[$output]"
    ;;
  afftdn)
    echo "[$input]$base,$(afftdn_filter),$(afftdn_expander),$tone,$compressor[$output]"
    ;;
  *)
    # Clean-up off: only the capture-pop mute and the format the mixer
    # expects. No gain, tone or compression — the take is left as recorded.
    echo "[$input]volume=enable='lt(t,0.4)':volume=0,afade=t=in:st=0.4:d=0.05,aformat=sample_fmts=fltp:sample_rates=48000:channel_layouts=mono[$output]"
    ;;
  esac
}

# audio_graph <stream-count> <mic-bool> <desktop-bool> <engine>
# New recordings store mic and desktop audio as separate streams. Older
# one-stream combined recordings remain recoverable and are treated as voice.
audio_graph() {
  local streams="$1" mic="$2" desktop="$3" engine="$4" graph
  if [[ $mic == true ]]; then
    graph=$(voice_graph "0:a:0" "$engine" voice) || return 1
    if [[ $desktop == true && $streams -gt 1 ]]; then
      graph+=";[voice]pan=stereo|c0=c0|c1=c0[voice_stereo]"
      graph+=";[0:a:1]aformat=sample_fmts=fltp:sample_rates=48000:channel_layouts=stereo,volume=$(cfg .desktopMix 0.5)[desktop]"
      graph+=";[voice_stereo][desktop]amix=inputs=2:duration=longest:dropout_transition=2:normalize=0[premaster]"
    else
      [[ $desktop != true || $streams -gt 1 ]] || log "finalize: legacy combined audio track; denoising the combined track"
      graph+=";[voice]anull[premaster]"
    fi
  else
    graph="[0:a:0]aformat=sample_fmts=fltp:sample_rates=48000[premaster]"
  fi
  echo "$graph"
}

# Measure the exact post-denoise/mix signal for the second loudnorm pass.
loudnorm_measure_graph() {
  local raw="$1" graph="$2" j
  j=$(ffmpeg -hide_banner -nostdin -ss 0.1 -vn -i "$raw" -filter_complex \
    "$graph;[premaster]loudnorm=I=-16:TP=-1.5:LRA=11:print_format=json[meter]" \
    -map "[meter]" -f null - 2>&1 | sed -n '/^{/,/^}/p')
  local mi mt ml mth off
  mi=$(jq -r '.input_i // empty' <<<"$j" 2>/dev/null)
  # A take containing only rejected background legitimately measures as
  # silence. Keep RNNoise's silent result instead of treating it as a failed
  # engine and falling back to a weaker denoiser that brings the noise back.
  if [[ $mi == -inf ]]; then
    echo anull
    return 0
  fi
  [[ $mi =~ ^-?[0-9]+([.][0-9]+)?$ ]] || return 1
  # A take with almost no speech must not have its residual noise boosted all
  # the way to speech loudness. Cap make-up gain at 18 dB for very quiet input.
  if awk -v level="$mi" 'BEGIN {exit !(level < -34)}'; then
    echo 'volume=18dB'
    return 0
  fi
  mt=$(jq -r .input_tp <<<"$j"); ml=$(jq -r .input_lra <<<"$j"); mth=$(jq -r .input_thresh <<<"$j"); off=$(jq -r .target_offset <<<"$j")
  echo "loudnorm=I=-16:TP=-1.5:LRA=11:measured_I=$mi:measured_TP=$mt:measured_LRA=$ml:measured_thresh=$mth:offset=$off:linear=true"
}

# Resolve the new position key while preserving configurations from <= 0.7.7.
webcam_position() {
  local position
  position=$(cfg .webcamPosition "")
  [[ -n $position ]] || position=$(cfg .webcamCorner bottom-right)
  case "$position" in
  top-left | top-center | top-right | center-left | center-right | bottom-left | bottom-center | bottom-right)
    echo "$position"
    ;;
  *) echo bottom-right ;;
  esac
}

webcam_zoom_percent() {
  case "$1" in
  close) echo 125 ;;
  tight) echo 150 ;;
  *) echo 100 ;;
  esac
}

webcam_shape_ratio() {
  case "$1" in
  circle) echo "1 1" ;;
  classic) echo "4 3" ;;
  portrait) echo "8 9" ;;
  *) echo "16 9" ;;
  esac
}

# camera_crop_size <input-w> <input-h> <shape> <zoom> -> even crop dimensions.
# The live mask uses these exact dimensions; export uses the equivalent
# expression in bubble_crop before scaling to the requested overlay size.
camera_crop_size() {
  local iw="$1" ih="$2" shape="$3" zoom="$4" rw rh pct bw bh
  read -r rw rh <<<"$(webcam_shape_ratio "$shape")"
  pct=$(webcam_zoom_percent "$zoom")
  if ((iw * rh > ih * rw)); then
    bh=$ih
    bw=$((ih * rw / rh))
  else
    bw=$iw
    bh=$((iw * rh / rw))
  fi
  bw=$((bw * 100 / pct / 2 * 2))
  bh=$((bh * 100 / pct / 2 * 2))
  ((bw >= 2)) || bw=2
  ((bh >= 2)) || bh=2
  echo "$bw $bh"
}

# The camera picture can be landscape (16:9), classic rectangle (4:3),
# portrait (8:9), or a circle. The same geometry drives the live self-view and
# the exported composite.
# bubble_size <anchor-height> <size> <shape> -> "w h" in the anchor's pixels
bubble_size() {
  local anchor_h="$1" size="$2" shape="$3" h w
  case "$size" in
  small) h=$((anchor_h * 16 / 100)) ;;
  large) h=$((anchor_h * 30 / 100)) ;;
  xlarge) h=$((anchor_h * 40 / 100)) ;;
  *) h=$((anchor_h * 22 / 100)) ;;
  esac
  case "$shape" in
  circle) w=$h ;;
  classic) w=$((h * 4 / 3)) ;;
  portrait) w=$((h * 8 / 9)) ;;
  *) w=$((h * 16 / 9)) ;;
  esac
  echo "$((w / 2 * 2)) $((h / 2 * 2))"
}

# Center crop to the selected aspect and zoom. Zooming crops rather than
# stretching, so faces retain their proportions in every frame style.
bubble_crop() {
  local rw rh pct
  read -r rw rh <<<"$(webcam_shape_ratio "$1")"
  pct=$(webcam_zoom_percent "${2:-full}")
  printf "crop=trunc(min(iw\\,ih*%d/%d)*100/%d/2)*2:trunc(min(ih\\,iw*%d/%d)*100/%d/2)*2:(iw-ow)/2:(ih-oh)/2," \
    "$rw" "$rh" "$pct" "$rh" "$rw" "$pct"
}

# anti-aliased rounded-rectangle alpha (0..255) with corner radius <r>;
# r = H/2 on a square is a circle
bubble_mask_expr() {
  local r="$1"
  printf "255*clip(%s-sqrt(pow(max(abs(X-W/2)-(W/2-%s)\\,0)\\,2)+pow(max(abs(Y-H/2)-(H/2-%s)\\,0)\\,2))+0.5\\,0\\,1)" "$r" "$r" "$r"
}

# radius for a frame of height h and the given shape
bubble_radius() {
  local h="$1" shape="$2"
  case "$shape" in circle) echo $((h / 2)) ;; *) echo $((h * 8 / 100)) ;; esac
}

# overlay position expression for one of eight safe-edge anchors.
bubble_position() {
  local position="$1" m="$2"
  case "$position" in
  top-left) echo "$m:$m" ;;
  top-center) echo "(W-w)/2:$m" ;;
  top-right) echo "W-w-$m:$m" ;;
  center-left) echo "$m:(H-h)/2" ;;
  center-right) echo "W-w-$m:(H-h)/2" ;;
  bottom-left) echo "$m:H-h-$m" ;;
  bottom-center) echo "(W-w)/2:H-h-$m" ;;
  *) echo "W-w-$m:H-h-$m" ;;
  esac
}

# Composite path. bubble_filter <video-h> <size> <shape> <position> <zoom> <delta-s>
# Output pad [cam]: RGBA, transparent until the camera's first frame.
bubble_filter() {
  local h="$1" size="$2" shape="$3" position="$4" zoom="$5" delta="$6" w bh m
  read -r w bh <<<"$(bubble_size "$h" "$size" "$shape")"
  m=$((h * 3 / 100))
  local timing
  if awk -v d="$delta" 'BEGIN{exit !(d >= 0)}'; then
    timing="setpts=PTS-STARTPTS,tpad=start_duration=$delta:color=0x00000000"
  else
    timing="trim=start=$(awk -v d="$delta" 'BEGIN{printf "%.3f", -d}'),setpts=PTS-STARTPTS"
  fi
  printf '[1:v]%sscale=%d:%d,format=rgba[c];[2:v]format=gray[m];[c][m]alphamerge,%s[cam];[0:v][cam]overlay=%s:eof_action=pass:format=auto[v]' \
    "$(bubble_crop "$shape" "$zoom")" "$w" "$bh" "$timing" "$(bubble_position "$position" "$m")"
}

# bubble_mask_png <w> <h> <shape> <out.png>: the alpha mask rendered once;
# alphamerge then costs nothing per frame.
bubble_mask_png() {
  local w="$1" h="$2" shape="$3" out="$4"
  ffmpeg -y -v error -f lavfi -i "color=white:size=${w}x${h}" \
    -vf "format=gray,geq=lum='$(bubble_mask_expr "$(bubble_radius "$h" "$shape")")'" -frames:v 1 "$out"
}

# Place the on-screen camera window (mpv, found by class) in the chosen corner
# of the anchor: the recorded region "WxH+X+Y", or the focused monitor.
# place_overlay <class> <size> <shape> <position> [region]
place_overlay() {
  local class="$1" size="$2" shape="$3" position="$4" region="${5:-}" addr ax ay aw ah
  addr=$(hyprctl -j clients | jq -r --arg c "$class" 'first(.[] | select(.class == $c and .title == "WebcamOverlay")) | .address // empty')
  [[ -n $addr ]] || return 1
  if [[ $region =~ ^([0-9]+)x([0-9]+)\+(-?[0-9]+)\+(-?[0-9]+)$ ]]; then
    aw=${BASH_REMATCH[1]} ah=${BASH_REMATCH[2]} ax=${BASH_REMATCH[3]} ay=${BASH_REMATCH[4]}
  else
    read -r ax ay aw ah <<<"$(hyprctl -j monitors | jq -r 'first(.[] | select(.focused)) | . as $m
      | (if ($m.transform % 2) == 1 then [$m.height, $m.width] else [$m.width, $m.height] end) as $d
      | "\($m.x) \($m.y) \(($d[0] / $m.scale) | floor) \(($d[1] / $m.scale) | floor)"')"
  fi
  [[ -n ${aw:-} ]] || return 1
  local w h m x y
  read -r w h <<<"$(bubble_size "$ah" "$size" "$shape")"
  m=$((ah * 3 / 100))
  case "$position" in
  top-left) x=$((ax + m)); y=$((ay + m)) ;;
  top-center) x=$((ax + (aw - w) / 2)); y=$((ay + m)) ;;
  top-right) x=$((ax + aw - w - m)); y=$((ay + m)) ;;
  center-left) x=$((ax + m)); y=$((ay + (ah - h) / 2)) ;;
  center-right) x=$((ax + aw - w - m)); y=$((ay + (ah - h) / 2)) ;;
  bottom-left) x=$((ax + m)); y=$((ay + ah - h - m)) ;;
  bottom-center) x=$((ax + (aw - w) / 2)); y=$((ay + ah - h - m)) ;;
  *) x=$((ax + aw - w - m)); y=$((ay + ah - h - m)) ;;
  esac
  hypr_dispatch "hl.dsp.window.resize({ window = \"address:$addr\", x = $w, y = $h })" \
    resizewindowpixel "exact $w $h,address:$addr" || return 1
  hypr_dispatch "hl.dsp.window.move({ window = \"address:$addr\", x = $x, y = $y })" \
    movewindowpixel "exact $x $y,address:$addr"
  # Invisible to window/portal capture (and to any screen share you run);
  # KMS area/screen captures still see it, which is what those modes want.
  hyprctl dispatch "hl.dsp.window.set_prop({ window = \"address:$addr\", prop = \"no_screen_share\", value = 1 })" >/dev/null 2>&1 || true
  hyprctl dispatch "hl.dsp.window.set_prop({ window = \"address:$addr\", prop = \"border_size\", value = 0 })" >/dev/null 2>&1 || true
}

# hypr_dispatch <lua-call> <legacy-dispatcher> <legacy-args>: Hyprland 0.56+
# only accepts the Lua form; older releases only the legacy one.
hypr_dispatch() {
  local lua="$1"
  shift
  hyprctl dispatch "$lua" >/dev/null 2>&1 || hyprctl dispatch "$@" >/dev/null 2>&1
}

# finalize_video raw out denoise composite mic desktop [size shape position zoom]
# composite: draw the camera take in (Window recordings; Area/Screen captures
# already contain the self-view).
finalize_video() {
  local raw="$1" out="$2" denoise="${3:-true}" composite="${4:-false}"
  local mic="${5:-true}" desktop="${6:-false}"
  local webcam_size="${7:-$(cfg .webcamSize medium)}"
  local webcam_shape="${8:-$(cfg .webcamShape frame)}"
  local webcam_position_value="${9:-$(webcam_position)}"
  local webcam_zoom="${10:-$(cfg .webcamZoom full)}"
  [[ -s $raw ]] || return 1

  # Stream-copy unless the first GOP carries discardable warm-up packets.
  local video_codec=(-c:v copy)
  if ffprobe -v error -select_streams v:0 -read_intervals %+0.2 -show_entries packet=flags -of csv=p=0 "$raw" 2>/dev/null | grep -q D; then
    video_codec=(-c:v libx264 -preset veryfast -crf 18 -pix_fmt yuv420p)
  fi

  local has_audio=false audio_streams=0
  ffprobe -v error -select_streams a -show_entries stream=codec_type -of csv=p=0 "$raw" 2>/dev/null | grep -q audio && has_audio=true
  if [[ $has_audio == true ]]; then
    audio_streams=$(ffprobe -v error -select_streams a -show_entries stream=index -of csv=p=0 "$raw" 2>/dev/null | wc -l)
  fi

  local engines=()
  if [[ $has_audio == true && $mic == true && $denoise == true ]]; then
    case "$(denoise_engine)" in
    ladspa) engines=(ladspa arnndn afftdn) ;;
    arnndn) engines=(arnndn arnndn afftdn) ;;
    afftdn) engines=(afftdn) ;;
    off) engines=(none) ;;
    esac
  else
    engines=(none)
  fi

  # Window recordings: the capture never saw the self-view, so draw the camera take in.
  # as a round bubble, aligned by wall-clock: delta = camera start − recording
  # start − the 0.1 s trimmed off the front.
  local cam="${raw%.raw.mp4}.cam.mp4" cam_args=() cam_filter="" video_map=(-map 0:v:0)
  if [[ $composite == true && -f $cam ]] && ffprobe -v error -select_streams v:0 -show_entries stream=codec_type -of csv=p=0 "$cam" 2>/dev/null | grep -q video; then
    local cam_start raw_start height delta mask mask_w mask_h
    cam_start=$(ffprobe -v error -show_entries format=start_time -of csv=p=0 "$cam")
    raw_start=$(cat "${cam%.mp4}.start" 2>/dev/null || true)
    height=$(ffprobe -v error -select_streams v:0 -show_entries stream=height -of csv=p=0 "$raw")
    if [[ -n $cam_start && -n $raw_start && -n $height ]]; then
      delta=$(awk -v c="$cam_start" -v r="$raw_start" 'BEGIN{printf "%.3f", c - r - 0.1}')
      cam_filter=$(bubble_filter "$height" "$webcam_size" "$webcam_shape" "$webcam_position_value" "$webcam_zoom" "$delta")
      read -r mask_w mask_h <<<"$(bubble_size "$height" "$webcam_size" "$webcam_shape")"
      mask="$RUNTIME_DIR/mask-$$.png"
      bubble_mask_png "$mask_w" "$mask_h" "$webcam_shape" "$mask"
      cam_args=(-i "$cam" -loop 1 -i "$mask")
      video_map=(-map "[v]")
      video_codec=(-c:v libx264 -preset veryfast -crf 18 -pix_fmt yuv420p)
      log "finalize: compositing camera bubble (delta ${delta}s)"
    else
      log "finalize: camera file present but unreadable; skipping bubble"
    fi
  fi

  local tmp="${out%.mp4}.processing.mp4" engine
  for engine in "${engines[@]}"; do
    local args=(-y -ss 0.1 -i "$raw" "${cam_args[@]}")
    local filter_graph="$cam_filter" audio_filter="" ln=""
    local audio_map=(-an)
    if [[ $has_audio == true ]]; then
      if ! audio_filter=$(audio_graph "$audio_streams" "$mic" "$desktop" "$engine"); then
        log "finalize: audio graph preparation failed with $engine, trying next"
        continue
      fi
      if [[ $engine == none ]]; then
        # "Voice clean-up Off" means off: retain the recorded level and tone.
        # The graph still removes the capture pop and provides a stable format.
        audio_filter+=";[premaster]anull[aout]"
      else
        if ! ln=$(loudnorm_measure_graph "$raw" "$audio_filter"); then
          log "finalize: loudness measurement failed with $engine, trying next"
          continue
        fi
        audio_filter+=";[premaster]$(master_audio_filter "$ln")[aout]"
      fi
      [[ -n $filter_graph ]] && filter_graph+=";"
      filter_graph+="$audio_filter"
      audio_map=(-map "[aout]" -ar 48000 -c:a aac -b:a 192k)
    fi
    [[ -n $filter_graph ]] && args+=(-filter_complex "$filter_graph")
    args+=("${video_map[@]}" "${audio_map[@]}" "${video_codec[@]}" -map_metadata 0)
    # faststart puts the index at the front so browsers stream instantly.
    args+=(-movflags +faststart)

    if ffmpeg "${args[@]}" "$tmp" -loglevel error 2>>"$LOG_FILE"; then
      log "finalize $(basename "$out") denoise=$engine"
      mv "$tmp" "$out"
      rm -f "$RUNTIME_DIR/mask-$$.png"
      return 0
    fi
    log "finalize: engine $engine failed, trying next"
    rm -f "$tmp"
  done
  rm -f "$RUNTIME_DIR/mask-$$.png"
  return 1
}

# Rebuild timestamps from the processed sample count. Some loudnorm/limiter
# graphs emit a mid-stream PTS jump even though their PCM samples are contiguous.
# This changes timing only, not samples, and prevents silent gaps during playback.
master_audio_filter() {
  echo "$1,alimiter=limit=0.841:attack=5:release=80:level=false:latency=true,asetpts=N/SR/TB"
}

make_thumbnail() {
  local video="$1" thumb="$2"
  ffmpeg -y -ss 1 -i "$video" -vframes 1 -vf 'scale=960:-2' -q:v 3 "$thumb" -loglevel quiet 2>/dev/null ||
    ffmpeg -y -i "$video" -vframes 1 -vf 'scale=960:-2' -q:v 3 "$thumb" -loglevel quiet 2>/dev/null || true
}

video_duration() {
  ffprobe -v error -show_entries format=duration -of csv=p=0 "$1" 2>/dev/null | cut -d. -f1
}

# index_patch <file> '<jq filter for the matching entry>' [--arg …]
index_patch() {
  local file="$1" filter="$2" dir tmp
  shift 2
  dir=$(dirname "$file")
  [[ -f $dir/$INDEX_FILE_NAME ]] || return 0
  tmp="$dir/$INDEX_FILE_NAME.tmp"
  jq -c --arg file "$file" "$@" "if .file == \$file then ($filter) else . end" \
    "$dir/$INDEX_FILE_NAME" >"$tmp" && mv "$tmp" "$dir/$INDEX_FILE_NAME"
}

# index_entry <file> -> the entry JSON, or empty
index_entry() {
  local file="$1" dir
  dir=$(dirname "$file")
  [[ -f $dir/$INDEX_FILE_NAME ]] || return 0
  jq -c --arg file "$file" 'select(.file == $file)' "$dir/$INDEX_FILE_NAME" 2>/dev/null | tail -1
}

# append_index <file> <url> [id] [title]
append_index() {
  local file="$1" url="$2" id="${3:-}" title="${4:-}" dir
  dir=$(dirname "$file")
  [[ -n $id ]] || id=$(basename "${file%.mp4}")
  jq -nc --arg id "$id" --arg file "$file" --arg url "$url" --arg title "$title" \
    --argjson dur "$(video_duration "$file")" --arg target "$(state_get target)" \
    '{id: $id, file: $file, title: $title, url: $url, duration: $dur, target: $target, at: (now | floor)}' \
    >>"$dir/$INDEX_FILE_NAME"
}

# ---------------------------------------------------------------- upload ---

html_escape() { sed 's/&/\&amp;/g; s/</\&lt;/g; s/>/\&gt;/g; s/"/\&quot;/g' <<<"$1"; }

# Served as text/html, inline — chat apps (Slack, Teams…) then unfurl it as a
# page with a poster and a video, not as a file, and a click opens the player.
PAGE_HEADERS=(--s3-no-check-bucket --header-upload "Content-Type: text/html; charset=utf-8" --header-upload "Content-Disposition: inline" --header-upload "Cache-Control: public, max-age=300")

# player_page <video_url> <poster_url> <title> [local video for dimensions] [page_url]
player_page() {
  local video_url="$1" poster_url="$2" title w=1920 h=1080 dur="" page_url="${5:-}"
  title=$(html_escape "$3")
  video_url=$(html_escape "$video_url")
  poster_url=$(html_escape "$poster_url")
  page_url=$(html_escape "$page_url")
  if [[ -n ${4:-} && -f $4 ]]; then
    read -r w h <<<"$(ffprobe -v error -select_streams v:0 -show_entries stream=width,height -of csv=p=0 "$4" | tr ',' ' ')"
    dur=$(video_duration "$4")
  fi
  local desc="Screen recording"
  [[ -n $dur ]] && desc="Screen recording · $((dur / 60)):$(printf '%02d' $((dur % 60)))"
  cat <<HTML
<!doctype html>
<html lang="en"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="robots" content="noindex">
<title>$title</title>
<meta property="og:type" content="video.other"><meta property="og:title" content="$title">
<meta property="og:description" content="$desc">${page_url:+<meta property="og:url" content="$page_url">}
<meta property="og:image" content="$poster_url"><meta property="og:image:width" content="960">
<meta property="og:video" content="$video_url"><meta property="og:video:url" content="$video_url">
<meta property="og:video:secure_url" content="$video_url"><meta property="og:video:type" content="video/mp4">
<meta property="og:video:width" content="$w"><meta property="og:video:height" content="$h">
<meta name="twitter:card" content="summary_large_image"><meta name="twitter:title" content="$title">
<meta name="twitter:image" content="$poster_url">
<style>
  :root{color-scheme:dark}
  html,body{margin:0;min-height:100%;background:#0b0d12;color:#e8eaed;font:15px/1.5 system-ui,-apple-system,"Segoe UI",sans-serif}
  main{padding:20px 24px 40px;text-align:center}
  /* The frame hugs the video: sized by the video's own aspect, as tall as the
     viewport allows, never a letterboxed 16:9 box. */
  .player{display:inline-block;max-width:100%;line-height:0;border-radius:14px;overflow:hidden;background:#000;box-shadow:0 24px 80px rgba(0,0,0,.6)}
  video{display:block;width:auto;height:auto;max-width:100%;max-height:calc(100vh - 140px);min-width:min(960px,100%)}
  .about{max-width:1440px;margin:0 auto;text-align:left}
  h1{font-size:20px;font-weight:600;margin:18px 0 4px;letter-spacing:-.01em}
  .meta{color:#9aa0a6;font-size:13px;margin:0}.meta a{color:#9aa0a6}
</style></head><body><main>
<div class="player"><video controls playsinline preload="metadata" width="$w" height="$h" poster="$poster_url" src="$video_url"></video></div>
<div class="about"><h1>$title</h1>
<p class="meta">$desc · $(date '+%b %-d, %Y') · Recorded with <a href="https://github.com/hadijaveed/omareel">Omareel</a></p></div>
</main></body></html>
HTML
}

# All provider validation and URL construction use the same implementation.
upload_config() { python3 "$PLUGIN_DIR/bin/upload-config.py" "$1" "$CONFIG_FILE" "$RCLONE_CONF" "${@:2}"; }
upload_ready() { upload_config validate >/dev/null 2>&1; }
remote_path() { upload_config path 2>/dev/null; }
public_base() { upload_config base; }
public_object_url() { upload_config url "$1"; }

# Pin the same rclone config for every operation, including custom locations.
rclone_run() { rclone "$@" --config "$RCLONE_CONF"; }

share_link() {
  local link
  local expiry=()
  if upload_config status | jq -e '.backend == "s3"' >/dev/null; then
    expiry=(--expire 168h)
  fi
  link=$(rclone_run link "$1" "${expiry[@]}" 2>>"$LOG_FILE") || {
    echo "Upload succeeded, but this remote could not create a share link. Set a public URL or use a link-capable remote." >&2
    return 1
  }
  link="${link##*$'\n'}"
  if [[ ! $link =~ ^https?://[^[:space:]]+$ ]]; then
    echo "rclone did not return a valid share URL" >&2
    return 1
  fi
  printf '%s\n' "$link"
}

# upload_video <video> [thumb] [title] [id] -> prints the share URL
upload_video() (
  local video="$1" thumb="${2:-}" title="${3:-}" id="${4:-}"
  local remote base snapshot page=""
  snapshot=$(mktemp "$RUNTIME_DIR/upload-config.XXXXXX") || return 1
  cp "$CONFIG_FILE" "$snapshot" || { rm -f "$snapshot"; return 1; }
  CONFIG_FILE="$snapshot"
  trap 'rm -f "$snapshot"; [[ -z $page ]] || rm -f "$page"' EXIT
  upload_config validate || return 1
  remote=$(remote_path) || return 1
  base=$(public_base) || return 1

  if [[ -z $remote ]]; then
    echo "upload: no destination configured (Omareel settings → Sharing)" >&2
    return 1
  fi
  if ! command -v rclone >/dev/null; then
    echo "upload: rclone is not installed (sudo pacman -S rclone)" >&2
    return 1
  fi

  [[ -n $id ]] || id=$(basename "${video%.mp4}")
  local remote_video="$remote/$id.mp4"

  # Stream progress into the state file so the UI can show a percentage.
  local progress_log="$RUNTIME_DIR/rclone.log"
  : >"$progress_log"
  rclone_run copyto "$video" "$remote_video" --stats 1s --stats-one-line --stats-log-level NOTICE \
    --header-upload "Content-Type: video/mp4" --header-upload "Content-Disposition: inline" \
    --header-upload "Cache-Control: public, max-age=31536000" \
    --s3-no-check-bucket --ignore-times >"$progress_log" 2>&1 &
  local rpid=$!
  while kill -0 "$rpid" 2>/dev/null; do
    local pct
    pct=$(grep -oE '[0-9]+%' "$progress_log" | tail -1 | tr -d %)
    [[ -n $pct ]] && set_state uploading progress="$pct"
    sleep 1
  done
  wait "$rpid" || {
    echo "upload failed:" >&2
    tail -5 "$progress_log" >&2
    log "upload failed: $(tail -1 "$progress_log")"
    return 1
  }

  local video_url page_url=""
  if [[ -n $base ]]; then
    video_url=$(public_object_url "$id.mp4") || return 1
  else
    # Providers without a public base (Drive, Dropbox, OneDrive…) hand out links.
    video_url=$(share_link "$remote_video") || return 1
  fi

  local poster_url=""
  if [[ -n $thumb && -f $thumb ]]; then
    if rclone_run copyto "$thumb" "$remote/$id.jpg" -q --s3-no-check-bucket \
        --header-upload "Content-Type: image/jpeg" --header-upload "Content-Disposition: inline" 2>>"$LOG_FILE"; then
      [[ -z $base ]] || poster_url=$(public_object_url "$id.jpg")
    else
      log "thumbnail upload failed for $id; sharing video without a poster"
    fi
  fi

  if [[ -n $base && $(cfg '.upload.playerPage' true) == true ]]; then
    page=$(mktemp "$RUNTIME_DIR/player.XXXXXX.html") || return 1
    [[ -n $title ]] || title="Recording $(date -r "$video" '+%Y-%m-%d %H:%M')"
    player_page "$video_url" "$poster_url" "$title" "$video" "$(public_object_url "$id.html")" >"$page"
    if rclone_run copyto "$page" "$remote/$id.html" -q "${PAGE_HEADERS[@]}" 2>>"$LOG_FILE"; then
      page_url=$(public_object_url "$id.html")
    fi
    rm -f "$page"
  fi

  echo "${page_url:-$video_url}"
)

# cmd_page last|<video.mp4> — re-render and re-upload only the share page of a
# recording that is already uploaded (after a page design change; the video
# stays where it is).
cmd_page() {
  local file entry id title url base remote
  file=$(resolve_recording "${1:-last}") || return 1
  entry=$(index_entry "$file")
  url=$(jq -r '.url // empty' <<<"$entry")
  if [[ -z $url ]]; then
    echo "page: $(basename "$file") is not uploaded yet — use: omareel upload" >&2
    return 1
  fi
  id=$(jq -r '.id // empty' <<<"$entry")
  title=$(jq -r '.title // empty' <<<"$entry")
  [[ -n $id ]] || id=$(basename "${file%.mp4}")
  [[ -n $title ]] || title="Recording $(date -r "$file" '+%Y-%m-%d %H:%M')"
  upload_config validate || return 1
  base=$(public_base) || return 1
  remote=$(remote_path) || return 1
  if [[ -z $base || -z $remote ]]; then
    echo "page: needs a public base URL and a destination (Omareel settings → Sharing)" >&2
    return 1
  fi
  if [[ $url != "$(public_object_url "$id.html")" && $url != "$(public_object_url "$id.mp4")" ]]; then
    echo "page: this recording belongs to a different sharing destination; original link preserved" >&2
    return 1
  fi
  local page
  page=$(mktemp "$RUNTIME_DIR/player.XXXXXX.html") || return 1
  player_page "$(public_object_url "$id.mp4")" "$(public_object_url "$id.jpg")" "$title" "$file" "$(public_object_url "$id.html")" >"$page"
  rclone_run copyto "$page" "$remote/$id.html" -q "${PAGE_HEADERS[@]}" 2>>"$LOG_FILE" || {
    rm -f "$page"
    echo "page: upload failed (see $LOG_FILE)" >&2
    return 1
  }
  rm -f "$page"
  public_object_url "$id.html"
}

# cmd_upload last|<video.mp4> [--title=…]
cmd_upload() {
  local target="last" title="" arg
  for arg in "$@"; do
    case "$arg" in
    --title=*) title="${arg#*=}" ;;
    *) target="$arg" ;;
    esac
  done
  local file
  file=$(resolve_recording "$target") || return 1
  if ! upload_ready; then
    notify -u critical -t 5000 "Omareel: no upload destination" "Finish the Sharing section in settings first"
    return 1
  fi

  # The object key is the recording's id (a UUID for new recordings, the old
  # file name for recordings made before ids existed); renames do not move it.
  local entry id
  entry=$(index_entry "$file")
  if [[ -z $entry ]]; then
    append_index "$file" "" "$(new_id)"
    entry=$(index_entry "$file")
  fi
  id=$(jq -r '.id // empty' <<<"$entry")
  [[ -n $id ]] || id=$(basename "${file%.mp4}")
  [[ -n $title ]] || title=$(jq -r '.title // empty' <<<"$entry")
  [[ -n $title ]] && file=$(rename_recording "$file" "$title")

  local thumb="${file%.mp4}.jpg"
  [[ -f $thumb ]] || make_thumbnail "$file" "$thumb"
  set_state uploading file="$file" progress=0 title="$title"
  local url
  if ! url=$(upload_video "$file" "$thumb" "$title" "$id"); then
    set_state done file="$file" url="" canUpload=true title="$title"
    notify -u critical -t 8000 "Omareel upload failed" "See $LOG_FILE"
    return 1
  fi
  printf '%s' "$url" | wl-copy 2>/dev/null || true
  index_patch "$file" '.url = $url | .title = $title' --arg url "$url" --arg title "$title"
  set_state done file="$file" url="$url" progress=100 canUpload=false title="$title"
  notify -u normal -t 10000 --image "$thumb" "Omareel link copied" "${title:-$url}" --exec xdg-open "$url"
  echo "$url"
}

# cmd_rename last|<video.mp4> <title>
cmd_rename() {
  local target="${1:-last}" title="${2:-}"
  [[ -n $title ]] || { echo "usage: omareel rename last|<video.mp4> \"<title>\"" >&2; return 2; }
  local file new entry
  file=$(resolve_recording "$target") || return 1
  entry=$(index_entry "$file")
  [[ -n $entry ]] || append_index "$file" "" "$(new_id)"
  new=$(rename_recording "$file" "$title")
  # Refresh only if the old link still matches the selected destination.
  local url
  url=$(jq -r '.url // empty' <<<"$entry")
  if [[ -n $url && $(cfg '.upload.playerPage' true) == true && -n $(cfg '.upload.publicBase' "") ]]; then
    cmd_page "$new" >/dev/null 2>>"$LOG_FILE" || log "player page not refreshed; original share link preserved"
  fi
  echo "$new"
}

# cmd_copy last|<video.mp4> — link if shared, else the local path
cmd_copy() {
  local file share
  file=$(resolve_recording "${1:-last}") || return 1
  share=$(index_entry "$file" | jq -r '.url // empty')
  share="${share:-$file}"
  printf '%s' "$share" | wl-copy 2>/dev/null || true
  echo "$share"
}

# ---------------------------------------------------------------- remote ---
# Credentials live only in rclone.conf (mode 600). They reach this script via
# environment variables so they never appear in argv or in omareel.json.

# remote save — env: OMAREEL_ACCESS_KEY_ID, OMAREEL_SECRET_ACCESS_KEY
cmd_remote_save() { upload_config save; }
cmd_remote_status() { upload_config status; }

# A unique probe is uploaded, read back byte-for-byte, shared and removed.
# No user's recording is uploaded, and cleanup failure is never called success.
cmd_remote_test() (
  local work remote base name link out attempted=false
  work=$(mktemp -d "$RUNTIME_DIR/upload-test.XXXXXX") || return 1
  cp "$CONFIG_FILE" "$work/config.json" || { rmdir "$work"; return 1; }
  CONFIG_FILE="$work/config.json"
  trap 'rm -f "$work/config.json"; rmdir "$work" 2>/dev/null || true' EXIT
  upload_config validate || return 1
  remote=$(remote_path) || return 1
  base=$(public_base) || return 1
  name="omareel-probe-$(new_id).txt"
  probe_cleanup() {
    local result=$?
    trap - EXIT
    if [[ $attempted == true ]] && ! rclone_run deletefile "$remote/$name" -q --retries 1 --low-level-retries 1 --contimeout 10s --timeout 20s 2>>"$LOG_FILE"; then
      echo "Probe cleanup failed: remove only $remote/$name (check delete permission)." >&2
      result=1
    fi
    rm -f "$work/config.json" "$work/probe.txt" "$work/readback.txt" "$work/public.txt"
    rmdir "$work"
    [[ $result == 0 ]] && echo "All good: upload, read-back, share access and probe cleanup passed."
    exit "$result"
  }
  trap probe_cleanup EXIT
  trap 'exit 130' INT
  trap 'exit 143' TERM
  printf 'Omareel upload test %s\n' "$name" >"$work/probe.txt"
  attempted=true
  if ! out=$(rclone_run copyto "$work/probe.txt" "$remote/$name" --s3-no-check-bucket \
      --retries 1 --low-level-retries 1 --contimeout 10s --timeout 20s 2>&1); then
    echo "Upload failed: $(tail -1 <<<"$out")" >&2
    return 1
  fi
  if ! rclone_run cat "$remote/$name" --retries 1 --low-level-retries 1 \
      --contimeout 10s --timeout 20s >"$work/readback.txt" 2>>"$LOG_FILE" \
      || ! cmp -s "$work/probe.txt" "$work/readback.txt"; then
    echo "Uploaded object could not be read back correctly (check read permission)." >&2
    return 1
  fi
  echo "Upload and byte-for-byte read-back passed."
  if [[ -n $base ]]; then
    link=$(public_object_url "$name") || return 1
  else
    link=$(share_link "$remote/$name") || return 1
  fi
  if ! curl --fail --location --silent --show-error --proto '=http,https' --proto-redir '=http,https' \
      --max-time 20 --max-filesize 1048576 --output "$work/public.txt" "$link"; then
    echo "Share URL is not accessible. Check the public URL, permissions, or signed-link support." >&2
    return 1
  fi
  if [[ -n $base ]] || upload_config status | jq -e '.backend == "s3"' >/dev/null; then
    if ! cmp -s "$work/probe.txt" "$work/public.txt"; then
      echo "Share URL returned different content. Check the bucket URL and folder mapping." >&2
      return 1
    fi
    echo "Share URL returned the exact uploaded content."
  else
    echo "Provider share page is reachable; storage content verified separately."
  fi
  [[ -n $base ]] || echo "Without a public URL, link lifetime depends on the backend (S3: up to 7 days)."
)

# ----------------------------------------------------------------- misc ---

cmd_status() {
  [[ -f $STATE_FILE ]] || jq -n '{phase: "idle", updatedAt: (now | floor)}' >"$STATE_FILE"
  cat "$STATE_FILE"
}

cmd_doctor() {
  local checks mic_device mic_volume_line="" mic_volume_percent="" mic_volume_db=""
  checks=$(compatibility_report area "${@}") || true
  jq -e 'type == "object"' <<<"$checks" >/dev/null 2>&1 || checks='{"ready":false,"errors":["Setup check failed. Check Python 3 and your settings file."],"warnings":[],"missing":[]}'
  mic_device=$(cfg .micDevice default)
  if command -v pactl >/dev/null 2>&1; then
    [[ $mic_device != default ]] || mic_device=$(pactl get-default-source 2>/dev/null)
    mic_volume_line=$(pactl get-source-volume "$mic_device" 2>/dev/null | head -1)
    mic_volume_percent=$(grep -oE '[0-9]+%' <<<"$mic_volume_line" | head -1 | tr -d %)
    mic_volume_db=$(grep -oE -- '-?[0-9]+([.][0-9]+)? dB' <<<"$mic_volume_line" | head -1 | cut -d' ' -f1)
  fi
  jq -n --arg engine "$(denoise_engine)" \
    --argjson ladspa "$([[ -f $LADSPA_RNNOISE ]] && echo true || echo false)" \
    --argjson models "$([[ -n $(model_path bd) ]] && echo true || echo false)" \
    --argjson rclone "$(command -v rclone >/dev/null && echo true || echo false)" \
    --argjson linked "$([[ $(readlink -f "$(command -v omareel)" 2>/dev/null) == "$SELF" ]] && echo true || echo false)" \
    --argjson checks "$checks" --arg log "$LOG_FILE" --arg version "$(plugin_version)" \
    --arg micVolumePercent "$mic_volume_percent" --arg micVolumeDb "$mic_volume_db" \
    --arg windowCaptureMode "$(cfg .windowCaptureMode region)" \
    --arg webcamSize "$(cfg .webcamSize medium)" --arg webcamShape "$(cfg .webcamShape frame)" \
    --arg webcamPosition "$(webcam_position)" --arg webcamZoom "$(cfg .webcamZoom full)" \
    '{engine: $engine, ladspa: $ladspa, models: $models, rclone: $rclone, linked: $linked,
      windowCaptureMode: $windowCaptureMode,
      micVolumePercent: (if $micVolumePercent == "" then null else ($micVolumePercent | tonumber) end),
      micVolumeDb: (if $micVolumeDb == "" then null else ($micVolumeDb | tonumber) end),
      micVolumeLow: (if $micVolumePercent == "" then false else (($micVolumePercent | tonumber) < 70) end),
      cameraLayout: {size: $webcamSize, shape: $webcamShape, position: $webcamPosition, zoom: $webcamZoom},
      log: $log, version: $version} + $checks'
}

plugin_version() { jq -r '.version // "dev"' "$PLUGIN_DIR/manifest.json" 2>/dev/null; }

cmd_last() {
  local dir
  dir=$(expand_home "$(cfg .outputDir "~/Videos/Omareel")")
  local last
  last=$(tail -1 "$dir/$INDEX_FILE_NAME" 2>/dev/null) || {
    echo "no recordings yet" >&2
    return 1
  }
  local share
  share=$(jq -r 'if .url != "" then .url else .file end' <<<"$last")
  printf '%s' "$share" | wl-copy 2>/dev/null || true
  echo "$share"
}

cmd_open() {
  local dir
  dir=$(expand_home "$(cfg .outputDir "~/Videos/Omareel")")
  mkdir -p "$dir"
  xdg-open "$dir" >/dev/null 2>&1 &
}

cmd_link() {
  link_cli "$HOME/.local/bin/omareel"
}

link_cli() {
  local target="$1"
  mkdir -p "$(dirname "$target")" || return 1
  if [[ -e $target || -L $target ]]; then
    if [[ $(readlink -f "$target") != "$SELF" ]]; then
      echo "Not replacing $target: it points to another file. Move it aside yourself, then retry." >&2
      return 1
    fi
  else
    ln -s "$SELF" "$target" || return 1
  fi
  echo "Linked $target"
  if [[ $(readlink -f "$(command -v omareel)" 2>/dev/null) != "$SELF" ]]; then
    echo "Add ~/.local/bin to PATH and reopen your terminal before using the keybinding." >&2
    return 1
  fi
}

cmd_setup() {
  local checks
  checks=$(compatibility_report area --probe-gpu)
  local result=$?
  jq -r '.errors[]? | "REQUIRED " + .' <<<"$checks"
  jq -r '.warnings[]? | "NOTE     " + .' <<<"$checks"
  ((result == 0)) || { echo "Setup incomplete. Resolve the requirements above and run setup again." >&2; return 1; }
  # Atomic verified downloads, pinned to an immutable upstream revision.
  timeout 75 python3 "$PLUGIN_DIR/bin/system-check.py" models "$MODEL_DIR" || {
    echo "Voice model setup incomplete. Existing models are untouched; run setup again when online." >&2
    return 1
  }
  if [[ ${1:-} == --link ]]; then cmd_link || return 1; fi
  echo "Ready for a short test recording. Verify picture, microphone and camera before a full take."
  echo "denoise: $(denoise_engine)"
  [[ -f $LADSPA_RNNOISE ]] || echo "Optional preferred cleanup: sudo pacman -S noise-suppression-for-voice"
  echo "Optional uploads: install rclone and curl, then use Settings → Test upload."
  echo "videos: $(expand_home "$(cfg .outputDir '~/Videos/Omareel')")"
}

usage() {
  sed -n '2,24p' "$SELF" | sed 's/^# \{0,1\}//'
}

# ------------------------------------------------------------------ main ---

# Keep the helpers sourceable for geometry and filter regression tests.
[[ ${BASH_SOURCE[0]} == "$0" ]] || return 0

for bootstrap_dep in jq flock; do
  command -v "$bootstrap_dep" >/dev/null || { echo "Missing $bootstrap_dep. Install the requirements listed in README before starting Omareel." >&2; exit 1; }
done

# Serialize commands that mutate the recording or its saved result. --close
# ensures camera/recorder children do not inherit the lock after Start exits.
# This prevents a double Stop, upload during finalize, or two simultaneous
# pickers from overwriting shared state or processing the same file twice.
case "${1:-}" in
remote)
  if [[ ${2:-status} == save || ${2:-status} == test ]] && [[ ${OMAREEL_OPERATION_LOCKED:-0} != 1 ]]; then
    exec flock --nonblock --conflict-exit-code 75 --close "$RUNTIME_DIR/operation.lock" \
      env OMAREEL_OPERATION_LOCKED=1 "$SELF" "$@"
  fi
  ;;
start | stop | cancel | toggle | upload | rename | page | dismiss | finalize | setup | link)
  if [[ ${OMAREEL_OPERATION_LOCKED:-0} != 1 ]]; then
    exec flock --nonblock --conflict-exit-code 75 --close "$RUNTIME_DIR/operation.lock" \
      env OMAREEL_OPERATION_LOCKED=1 "$SELF" "$@"
  fi
  ;;
esac

ensure_config || exit 1
jq -e 'type == "object"' "$CONFIG_FILE" >/dev/null 2>&1 || {
  echo "Invalid settings JSON: $CONFIG_FILE. Restore a valid configuration; the file was not replaced." >&2
  exit 1
}

case "${1:-}" in
upload | rename | page | finalize | setup | link)
  case "$(current_phase)" in
  picking | starting | recording | processing | uploading)
    echo "Finish the current recording before changing or sharing a saved take." >&2
    exit 75
    ;;
  esac
  ;;
esac

case "${1:-}" in
start) shift; cmd_start "$@" ;;
stop) cmd_stop ;;
cancel) cmd_cancel ;;
dismiss) cmd_dismiss ;;
toggle) cmd_toggle ;;
menu) cmd_menu ;;
status) cmd_status ;;
devices) cmd_devices ;;
doctor) shift; cmd_doctor "$@" ;;
last) cmd_last ;;
open) cmd_open ;;
setup) shift; cmd_setup "$@" ;;
link) cmd_link ;;
config)
  case "${2:-get}" in
  get) cat "$CONFIG_FILE" ;;
  merge) config_merge "${3:-}" ;;
  path) echo "$CONFIG_FILE" ;;
  *) usage; exit 2 ;;
  esac
  ;;
remote)
  case "${2:-status}" in
  save) cmd_remote_save ;;
  status) cmd_remote_status ;;
  test) cmd_remote_test ;;
  *) usage; exit 2 ;;
  esac
  ;;
finalize)
  [[ -n ${2:-} ]] || { usage; exit 2; }
  finalize_video "$2" "${3:-${2%.raw.mp4}.mp4}" "$(cfg .denoise true)"
  ;;
upload) shift; cmd_upload "$@" ;;
page) shift; cmd_page "$@" ;;
rename) shift; cmd_rename "$@" ;;
copy) cmd_copy "${2:-last}" ;;
active) gsr_running ;;
-h | --help | help | "") usage ;;
*)
  echo "unknown command: $1" >&2
  usage
  exit 2
  ;;
esac
